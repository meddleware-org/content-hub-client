# What git must not track: installed dependencies, build output, caches, local environment files, logs, OS and editor files.
# (`dist/` is produced by `npm run build`; it is published to npm, not committed.)

# Dependencies
node_modules/

# Build output
dist/
build/

# Type-check cache
*.tsbuildinfo

# Test output
coverage/
.vitest-cache/

# Environment: local settings and secrets never belong in git (an example file may be committed).
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
